# ---------------------------------------------------------------------------
# GetYourJersey — variables d'environnement
# Copier en .env.local pour le développement. Ne jamais committer .env.local.
# ---------------------------------------------------------------------------

# PostgreSQL (Vercel Postgres en prod, fourni automatiquement par l'intégration)
DATABASE_URL=postgresql://user:password@localhost:5432/getyourjersey

# Token d'accès au dashboard admin (/admin). À changer impérativement en prod.
ADMIN_TOKEN=change-me-in-production

# URL publique du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob — stockage des photos clientes et des rendus.
# Laisser vide en local : le code bascule alors sur un stockage disque dans
# .next/cache/uploads (voir lib/blob.ts).
BLOB_READ_WRITE_TOKEN=

